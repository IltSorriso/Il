#!/bin/sh
# il — a linha de comando do projeto Il.
#
# AS CAMADAS. A regra e' uma so': uma camada so' chama a de baixo, e nenhuma
# camada escreve no deposito sem passar pela de verificar.
#
# As camadas NAO estao escritas aqui — nem a lista, nem o numero, nem o papel.
# Sao BOLHAS de especie `proposito` no proprio deposito, e este programa as LE':
# `il ajuda` monta as secoes a partir do que existir la'. Trocar uma camada e'
# gravar uma bolha, nao editar este arquivo. Acrescentar uma nova nao pede linha
# nenhuma aqui (a convencao de como chamar, essa sim, se declara no `case`).
set -u
IL_RAIZ=${IL_RAIZ:-$(cd "$(dirname "$0")/.." && pwd)}
DEP=${IL_DEPOSITO:-$IL_RAIZ/exemplos/deposito/objetos}
QUEB=${IL_QUEBRADOS:-$IL_RAIZ/exemplos/quebrados/objetos}
AQUI=$(dirname "$0")

# o INDICE DE NOMES: nome|especie|endereco. UMA passada, UM processo.
# GERADO a cada chamada: nao ha arquivo de indice para apodrecer.
indice() {
  awk 'FNR==1 { if (NR>1 && tipo!="") printf "%s|%s|%s\n", (nome==""?"-":nome), tipo, arq
                arq=FILENAME; sub(".*/","",arq); tipo=""; nome="" }
       /^tipo: /   { if (tipo=="") tipo=substr($0,7) }
       /^nome: /   { if (nome=="") nome=substr($0,7) }
       /^titulo: / { if (nome=="") nome=substr($0,7) }
       /^ramo: /   { if (nome=="") nome=substr($0,7) }
       /^numero: / { if (nome=="") nome=substr($0,7) }
       END         { if (tipo!="") printf "%s|%s|%s\n", (nome==""?"-":nome), tipo, arq }' \
    "$DEP"/* "$QUEB"/* 2>/dev/null | sort
}
linhas() { printf '%s\n' "$IDX" | awk -F'|' -v f="$1" 'f==""||$2==f {printf "  %-28s %-11s %s\n",$1,$2,substr($3,1,12)}'; }

# A CAMADA VEM DE BOLHA. Aqui so' se LE': a especificacao e os casos de uso
# estao no texto da bolha, nao neste arquivo.
camada() {
  for f in "$DEP"/*; do
    [ "$(sed -n '1p' "$f" 2>/dev/null)" = "tipo: proposito" ] || continue
    [ "$(sed -n 's/^nome: //p' "$f" 2>/dev/null | head -1)" = "$1" ] || continue
    t=$(sed -n 's/^texto: //p' "$f" 2>/dev/null | head -1)
    [ -f "$DEP/$t" ] && cat "$DEP/$t" || echo "  (o texto da camada '$1' NAO esta no deposito)"
    return 0
  done
  echo "  (a camada '$1' NAO esta no deposito) — dito em voz alta, nao silenciado"
}

ajuda() {
  echo "il — os comandos, por camada."
  echo
  echo "As camadas sao LIDAS do deposito: cada bolha de especie proposito vira uma"
  echo "secao, com a especificacao e os casos de uso que ela MESMA carrega. NAO ha"
  echo "lista de camadas aqui — acrescentar uma bolha acrescenta uma secao, sem tocar"
  echo "neste programa. Onde se le' COMO CHAMAR, a lista e' CONVENCAO DO CLI — nao lei"
  echo "do juiz, e por isso ela se diz convencao: camada sem convencao, o cli DIZ."
  echo
  # UMA passada, UM processo — o mesmo principio do `indice()`. O laco com `sed`
  # por camada lia o deposito inteiro quatro vezes.
  awk 'FNR==1 { if (NR>1 && tipo=="proposito") printf "%s %s\n", nome, tex
                tipo=""; nome=""; tex="" }
       /^tipo: /  { if (tipo=="") tipo=substr($0,7) }
       /^nome: /  { if (nome=="") nome=substr($0,7) }
       /^texto: / { if (tex=="")  tex=substr($0,8) }
       END { if (tipo=="proposito") printf "%s %s\n", nome, tex }' \
    "$DEP"/* 2>/dev/null | sort | while read -r n t; do
    echo "════════ $n ════════"
    if [ -f "$DEP/$t" ]; then cat "$DEP/$t"
    else echo "  (o texto da camada '$n' NAO esta no deposito) — dito, nao silenciado"; fi
    case "$n" in
      camada-1-estado)    echo; echo "  COMO CHAMAR:  il estado [--nomes|--janelas]   ·   il nome <nome>" ;;
      camada-2-verificar) echo; echo "  COMO CHAMAR:  il verificar   ·   il guarda   ·   il varredura" ;;
      camada-3-criar)     echo; echo "  COMO CHAMAR:  il nota \"texto\"   ·   il nota --apagar <endereco>   ·   il nota --listar" ;;
      camada-4-manter)    echo; echo "  COMO CHAMAR:  il alertas   ·   il nomes [--gerar]   ·   il manter <o que>" ;;
      *) echo; echo "  COMO CHAMAR:  (o cli NAO declara convencao para a camada '$n' — a camada e' lei, a convencao nao)" ;;
    esac
    echo
  done
  echo "  il comandos   esta ajuda   ·   il ajuda   o mesmo"
}

case "${1:-comandos}" in
  comandos|ajuda) ajuda ;;
  estado)
    IDX=$(indice)
    echo "estado do sistema — GERADO em $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo
    echo "  deposito   canon $(ls "$DEP" | wc -l | tr -d ' ') · quebrados $(ls "$QUEB" 2>/dev/null | wc -l | tr -d ' ')"
    echo "  especies   $(printf '%s\n' "$IDX" | cut -d'|' -f2 | sort -u | tr '\n' ' ')"
    echo "  janelas    $(printf '%s\n' "$IDX" | awk -F'|' '$2=="agente"' | wc -l | tr -d ' ') de agente · $(printf '%s\n' "$IDX" | awk -F'|' '$2=="proposito"' | wc -l | tr -d ' ') de proposito"
    echo
    case "${2:-}" in
      --nomes)   linhas "" ;;
      --janelas) echo "AS JANELAS — o endereco de cada uma, para os agentes usarem"; echo; linhas "agente"; echo; linhas "proposito" ;;
      *)         linhas "" ;;
    esac ;;
  nome)     IDX=$(indice); printf '%s\n' "$IDX" | grep "^$2|" || echo "nao existe janela com o nome '$2'" ;;
  alertas)  exec "$AQUI/alertas" ;;
  nomes)    shift; exec "$AQUI/nomes" "$@" ;;
  guarda)   exec "$AQUI/guarda" ;;
  nota)     shift; exec "$AQUI/nota" "$@" ;;
  varredura) exec "$AQUI/varredura" ;;
  verificar) echo "camada 2 — verificar"; echo "  porta: nada sobe sem esta camada verde"; echo "  corrida inteira:  lean --run cadeia/Cadeia.lean --etapa tudo" ;;
  criar)     echo "camada 3 — criar: il nota · janelas · musica (toda criacao passa pela camada 2 depois)" ;;
  manter)    echo "camada 4 — manter: prazos · ramos · janelas" ;;
  *)         echo "comando desconhecido: $1"; echo; ajuda ;;
esac
