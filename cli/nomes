#!/usr/bin/env python3
"""nomes — nomes PROVISORIOS, com alerta e prioridade visual.

POR QUE EXISTEM. Muitas especies nao tem campo de nome: `anotacao` tem
`conteudo`, `declaracao` tem `ramo`, `parte` tem `numero`. Seus objetos sao
alcancaveis so' pelo endereco. O nome provisorio e' um APELIDO gerado a partir
do CONTEUDO — um ponteiro legivel, nunca autoridade.

O NIVEL VEM DE FATOS, NAO DO MODELO. Quem diz a prioridade sao contas: prazo
vencendo, objeto reprovado, ausencia de nome proprio. O modelo so' da' o apelido.
Um modelo que responde sobre si mesmo ja' confabulou nesta bancada.

O CACHE E' ENDERECADO POR CONTEUDO: a chave e' o endereco do objeto. Se o
conteudo muda, o endereco muda, e o apelido velho simplesmente nao e' achado.
Nao ha apelido para apodrecer.
"""
import datetime, json, os, re, subprocess, sys
raiz = os.environ.get("IL_RAIZ") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEP = os.path.join(raiz, "exemplos", "deposito", "objetos")
QUEB = os.path.join(raiz, "exemplos", "quebrados", "objetos")
CACHE = os.path.join(raiz, ".nomes-temporarios")

def campos(p):
    """Os campos de uma BOLHA. CONTEUDO nao tem campos — tem bytes.

    O limiar e' o que o proprio projeto define: objeto cuja PRIMEIRA linha e'
    `tipo: ` e' BOLHA; objeto sem isso e' CONTEUDO. Medido 07/10/2026: 70/70 das
    bolhas do canone e 6/6 das quebradas tem `tipo:` na primeira linha.

    POR QUE ISSO IMPORTA. Antes desta correcao, QUALQUER linha com ": " virava
    campo — inclusive dentro de PROSA. O texto canonico `63faceec` (o que explica
    a lei do recipiente) tem a linha "nome: exemplos    padrao: .../objetos" no
    MEIO do texto, e passou a ter campos "A pergunta", "A proposta", "Custo
    medido" — e um campo `nome` que NAO EXISTE. Consequencias medidas:
      - `nivel()` achava "nome" no dict e respondia "nomeado" para um objeto SEM
        NOME PROPRIO, em vez de "SEM NOME PROPRIO — apelido provisorio";
      - a linha impressa mostrava PEDACO DO PROPRIO TEXTO como se fosse nome.
    E' a mesma classe de defeito do guarda que confundia Il com IltS: um leitor
    que nao distingue as duas coisas que precisa distinguir.
    """
    d = {}
    try:
        linhas = open(p, encoding="utf-8", errors="replace").read().split("\n")
    except OSError:
        return d
    if not linhas or not linhas[0].startswith("tipo: "):
        return d
    for l in linhas:
        if ": " in l[:200]:
            k, v = l.split(": ", 1)
            d.setdefault(k.strip(), v.strip())
    return d



def objetos():
    for pasta, prov in ((DEP, "canon"), (QUEB, "quebrado")):
        if not os.path.isdir(pasta): continue
        for h in sorted(os.listdir(pasta)):
            f = os.path.join(pasta, h)
            if os.path.isfile(f): yield h, f, prov

def texto_de(h, f, c, visto=0):
    # o texto do objeto: o que ele aponta, ou ele mesmo
    for campo in ("conteudo", "texto", "letra"):
        alvo = c.get(campo, "")
        if len(alvo) == 64:
            g = os.path.join(DEP, alvo)
            if os.path.isfile(g) and visto < 3:
                return texto_de(alvo, g, campos(g), visto + 1)
    if "tipo" not in c:
        return open(f, encoding="utf-8").read()
    return " ".join(c.values())

def cache(ler=True, gravar=None):
    d = {}
    if ler and os.path.isfile(CACHE):
        for l in open(CACHE, encoding="utf-8"):
            p = l.rstrip("\n").split("\t")
            if len(p) >= 2: d[p[0]] = p[1]
    if gravar is not None:
        with open(CACHE, "w", encoding="utf-8") as fh:
            for k in sorted(gravar): fh.write("%s\t%s\n" % (k, gravar[k]))
    return d

def nivel(c, prov, h):
    hoje = datetime.date.today()
    p = c.get("prazo")
    if p:
        try:
            d = (datetime.date.fromisoformat(p) - hoje).days
            if d < 0:  return 3, "PRAZO VENCIDO ha' %d dia(s)" % -d
            if d <= 7: return 3, "vence em %d dia(s)" % d
            if d <= 30: return 2, "vence em %d dias" % d
        except ValueError: return 3, "prazo MALFORMADO: %s" % p
    if prov == "quebrado": return 2, "caso de teste negativo"
    if "nome" not in c:    return 2, "SEM NOME PROPRIO — apelido provisorio"
    return 1, "nomeado"

def legivel_licenca(lic):
    """A licenca em forma LEGIVEL — porque a licenca e' o que DISTINGUE.

    `reservado` NAO e' bolha: e' estado, e o projeto ja' diz o que ele significa —
    ausencia deliberada de licenca, que NAO afirma visibilidade. Escrever o
    endereco nu de 64 caracteres nao diria nada ao modelo; escrever "publico"
    seria MENTIR. Entao le' a bolha de licenca quando ela esta' no acervo, e
    quando o campo e' `reservado` diz o que isso significa.
    """
    if not lic:
        return ""
    if lic == "reservado":
        return "reservado (ausencia deliberada de licenca — NAO afirma visibilidade)"
    if len(lic) == 64:
        for pasta in (DEP, QUEB):
            g = os.path.join(pasta, lic)
            if os.path.isfile(g):
                lc = campos(g)
                return "%s (catalogo: %s, nome: %s, sigilo: %s)" % (
                    lic[:12], lc.get("catalogo", "?"), lc.get("nome", "?"),
                    lc.get("sigilo", "?"))
        return "%s (bolha de licenca AUSENTE deste acervo)" % lic[:12]
    return lic


def ponteiro(valor):
    """Um campo que carrega ENDERECO: mostra o prefixo E o que ele APONTA.

    Endereco nu nao ajuda a distinguir duas anotacoes. O que distingue e' o
    CONTEUDO do alvo — e e' exatamente isso que a anotacao existe para dizer.

    MAS o alvo pode ser MIDIA. O projeto ja' decidiu o que fazer com isso: bytes
    que nao sao UTF-8 nao tem texto, e "a porta do texto nao julga o que nao e'
    texto". Despejar bytes de um PNG no recorte da' LIXO ao modelo — medido:
    uma anotacao do proprio canone aponta para um PNG, e a primeira versao desta
    funcao mandou 70 caracteres de binario. Entao DECODIFICA-SE ESTRITO, e a
    midia se declara midia.
    """
    if not valor or len(valor) != 64:
        return valor or ""
    for pasta in (DEP, QUEB):
        g = os.path.join(pasta, valor)
        if os.path.isfile(g):
            d = campos(g)
            if "tipo" in d:
                return "%s aponta para %s %s" % (
                    valor[:12], d.get("tipo"), d.get("nome", ""))
            try:
                bruto = open(g, "rb").read()
            except OSError:
                bruto = b""
            try:
                t = " ".join(bruto.decode("utf-8").split())
                return "%s aponta para texto: %s" % (valor[:12], t[:70])
            except UnicodeDecodeError:
                return ("%s aponta para MIDIA de %d bytes "
                        "(nao e' texto — a porta do texto nao julga)" % (valor[:12], len(bruto)))
    return "%s (ALVO AUSENTE deste acervo)" % valor[:12]



def ambito_deste_acervo():
    """O nome do AMBITO deste acervo, pela MESMA tabela que o servidor usa.

    O servidor le' `IL_AMBITOS=nome=caminho`. Aqui se faz a volta: procura o nome
    cujo caminho E' esta raiz. Assim o nome que o modelo recebe e o nome que o
    servidor serve NAO PODEM divergir — sao a mesma tabela, lida duas vezes.

    MEDIDO 07/10/2026: nao existe INSTANCIA de ambito no deposito (zero nos dois
    repos) e nenhum dos 25 campos se chama `ambito`. Logo, hoje, o ambito NAO e'
    dado — e' resolucao de ambiente. Esta funcao DIZ quando nao acha, em vez de
    inventar um nome: recorte que afirma um ambito inexistente e' a MESMA classe
    de defeito do guarda que confundia Il com IltS, e do mesmo recorte para as
    quatro anotacoes.
    """
    eu = os.path.abspath(raiz)
    for par in os.environ.get("IL_AMBITOS", "").split(","):
        if "=" in par:
            n, c = par.split("=", 1)
            if os.path.abspath(c.strip()) == eu:
                return n.strip()
    return ""


def alcance_por_objeto():
    """Quantos OBJETOS apontam para cada endereco. Uma passada.

    O chamador passava `0` LITERAL, entao "apontado por N objeto(s)" nunca saiu —
    apesar de o docstring prometer "quem o alcanca". Conta objetos que citam, nao
    citacoes: e' o que a mensagem diz.
    """
    rex = re.compile("[0-9a-f]{64}")
    conta = {}
    for h, f, prov in objetos():
        try:
            t = open(f, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for m in set(rex.findall(t)):
            if m != h:
                conta[m] = conta.get(m, 0) + 1
    return conta


def meta_janela(h, f, c, prov, alcancado_por, ambito=""):
    """A META-JANELA-MODULAR em miniatura: o recorte que o modelo recebe.

    Nao so' o CONTEUDO — ONDE o objeto esta', de que especie, de que ramo, e
    quem o alcanca.

    MEDIDO 07/10/2026, ANTES desta correcao: as QUATRO anotacoes canonicas
    (00de629d, 06ede03821ce, 3ac5e94fbcd5, a53df751b8ca) recebiam o MESMO
    recorte, com duas palavras: "especie: anotacao; procedencia: canon".

    Nao era so' a licenca que faltava. O laco lia oito chaves (nome, ramo, prazo,
    numero, papel, titulo, catalogo, sigilo) e a anotacao NAO TEM NENHUMA DELAS:
    os campos dela sao tipo, conteudo, licenca. O recorte saia vazio POR CONSTRUCAO
    para a especie mais comum do acervo.

    O docstring prometia cinco partes e chegavam duas:
      "o CONTEUDO"           nao vinha   (nao estava no laco)
      "ONDE o objeto esta'"  parcial     (procedencia: canon|quebrado)
      "de que especie"       vinha
      "de que ramo"          so' quando a especie tem `ramo`
      "quem o alcanca"       NUNCA       (o chamador passava 0 literal)
    """
    p = ["especie: %s" % (c.get("tipo") or "conteudo (sem tipo)"),
         "procedencia: %s" % prov,
         "ambito: %s" % (ambito or "NAO DECLARADO (nenhum IL_AMBITOS aponta para esta raiz)")]
    for k in ("nome", "ramo", "prazo", "numero", "papel", "titulo", "catalogo"):
        if k in c:
            p.append("%s: %s" % (k, c[k]))
    for k in ("conteudo", "texto", "letra"):
        if len(c.get(k, "")) == 64:
            p.append("%s: %s" % (k, ponteiro(c[k])))
            break
    if "sigilo" in c:
        p.append("sigilo: %s" % c["sigilo"])
    lic = legivel_licenca(c.get("licenca", ""))
    if lic:
        p.append("licenca: %s" % lic)
    if alcancado_por:
        p.append("apontado por %d objeto(s)" % alcancado_por)
    return "; ".join(p)



def apelido(h, f, c, memo, usar_modelo, recorte=""):
    if "nome" in c: return c["nome"], False
    if h in memo:   return memo[h], True
    if not usar_modelo: return "-", False
    t = texto_de(h, f, c)[:600].replace("\n", " ")
    pedido = ("Voce nomeia objetos de um acervo endereçado por conteudo. Recebera "
              "o RECORTE de um objeto (especie, procedencia, campos) e o TEXTO dele.\n"
              "Responda com DUAS linhas e nada mais:\n"
              "NOME: duas a quatro palavras, sem pontuacao, em portugues\n"
              "SINTESE: uma linha curta dizendo o que o objeto E' DENTRO DESTE acervo\n\n"
              "RECORTE: " + (recorte or "nao declarado") + "\n\nTEXTO: " + t)
    try:
        r = subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), "modelo"),
             pedido], capture_output=True, text=True, timeout=70)
        linhas = [l.strip() for l in r.stdout.strip().splitlines() if l.strip()]
        nome = sint = ""
        for l in linhas:
            if l.upper().startswith("NOME:"):    nome = l.split(":",1)[1].strip()
            elif l.upper().startswith("SINTESE"): sint = l.split(":",1)[1].strip()
        if not nome and linhas: nome = linhas[-1]
        n = (nome + " — " + sint) if sint else nome
    except Exception: n = "-"
    if n: memo[h] = n
    return n, True

def main():
    usar_modelo = "--gerar" in sys.argv
    memo = cache(); novos = dict(memo); saida = []
    amb = ambito_deste_acervo()
    alcan = alcance_por_objeto()
    for h, f, prov in objetos():
        c = campos(f)
        if not c: continue
        esp = c.get("tipo", "-")
        if esp in ("campo", "especie", "caminho", "vocabulario", "licenca"): continue
        n, gerado = apelido(h, f, c, novos, usar_modelo, meta_janela(h, f, c, prov, alcan.get(h, 0), amb))
        niv, porque = nivel(c, prov, h)
        saida.append((niv, n, esp, h, porque))
    if usar_modelo: cache(False, novos)
    saida.sort(key=lambda x: (-x[0], x[2], x[1]))
    marca = {3: "[!!!]", 2: "[ ! ]", 1: "[   ]"}
    print("NOMES — apelidos provisorios e alertas, por prioridade")
    print("  nivel vem de FATOS; o apelido vem do modelo quando o objeto nao tem nome")
    print()
    for niv, n, esp, h, porque in saida:
        # O APELIDO CARREGA A SINTESE, e a coluna de 26 nao cabe nome +
        # sintese (medido: "O Treze de Quarenta e Cinco" saiu como "O Treze de
        # Quarenta e Cinc"). Entao a SINTESE vai na linha de baixo: cortada, ela
        # sumiria em silencio.
        nome, _, sint = n.partition(" — ")
        print("  %s %-30s %-11s %s  %s" % (marca[niv], nome[:30], esp, h[:12], porque))
        if sint: print("        %s" % sint)
    c3 = sum(1 for s in saida if s[0] == 3)
    print()
    print("  %d objeto(s) · %d em ALTO · %d em MEDIO · %d com nome proprio" % (
        len(saida), c3, sum(1 for s in saida if s[0] == 2), sum(1 for s in saida if s[0] == 1)))
    return 1 if c3 else 0
sys.exit(main())
