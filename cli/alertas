#!/usr/bin/env python3
"""alertas — o nivel, calculado e nao opinado.

O QUE ENTRA NA CONTA, e sao tres coisas, nao uma:
  1. A BOLHA      — a forma dela, a especie, os campos que ela carrega
  2. OS METADADOS — nome proprio? prazo? alcancada por alguem? de que ramo?
  3. A CONFORMIDADE COM O ITINERARIO — as `declaracao` de A5 SAO o itinerario: elas
     carregam `ramo`, `prazo` e `texto`. Um ramo com trabalho nao fundido e SEM
     declaracao e' divida de processo, e o itinerario nao a registra.

E' DETERMINISTICO. Nao ha modelo aqui: toda linha sai de comparacao de campos e de
contas de data. O modelo da' apelido; ele nao da' nivel.

O nivel e' o MAIOR que qualquer sinal alcancar. Um objeto so' desce de nivel quando
nao ha' sinal nenhum.

RAMO FUNDIDO X RAMO ABANDONADO. Os dois nomeiam um ramo que nao existe. A diferenca
e' MEDIDA, e nao escrita a mao: se o compromisso que ADICIONOU a declaracao e'
ancestral da pindorama, o ramo foi fundido e a declaracao e' MEMORIA — nivel mais
baixo, sem prazo e sem alarme. Se nao for, ela ficou presa num ramo que nunca se
juntou, e isso e' divida de verdade, que continua gritando.
"""
import datetime, os, re, subprocess, sys
raiz = os.environ.get("IL_RAIZ") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEP = os.path.join(raiz, "exemplos", "deposito", "objetos")
QUEB = os.path.join(raiz, "exemplos", "quebrados", "objetos")
HOJE = datetime.date.today()

def campos(p):
    d = {}
    try:
        for l in open(p, encoding="utf-8"):
            if ": " in l[:200]:
                k, v = l.split(": ", 1)
                d.setdefault(k.strip(), v.strip())
    except Exception: pass
    return d

def todos():
    for pasta, prov in ((DEP, "canon"), (QUEB, "quebrado")):
        if not os.path.isdir(pasta): continue
        for h in sorted(os.listdir(pasta)):
            f = os.path.join(pasta, h)
            if os.path.isfile(f): yield h, f, prov

def tronco():
    """O ramo principal DESTE repositorio. NUNCA um nome fixo: o Il chama o dele de
    pindorama, o atelie de atelie, e o alertas roda nos dois. Fixar o nome faz o
    veredito DEPENDER do repositorio — e o defeito fica invisivel, porque a resposta
    errada e' uma resposta. Procura na ordem e fica com o primeiro que resolver."""
    for c in ("refs/remotes/origin/HEAD", "refs/heads/pindorama",
              "refs/heads/main", "refs/heads/master"):
        r = subprocess.run(["git", "-C", raiz, "symbolic-ref", "--short", c],
                           capture_output=True, text=True, timeout=20)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip().replace("origin/", "")
        v = subprocess.run(["git", "-C", raiz, "rev-parse", "--verify", "--quiet", c],
                           capture_output=True, timeout=20)
        if v.returncode == 0:
            return c.replace("refs/heads/", "").replace("refs/remotes/origin/", "")
    r = subprocess.run(["git", "-C", raiz, "symbolic-ref", "--short", "HEAD"],
                       capture_output=True, text=True, timeout=20)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None

def ramos():
    """os ramos locais com trabalho NAO fundido na linha principal DESTE repositorio"""
    t = tronco()
    if not t: return []
    try:
        r = subprocess.run(["git", "-C", raiz, "branch", "--format=%(refname:short)"],
                           capture_output=True, text=True, timeout=20)
        todos_r = [b.strip() for b in r.stdout.splitlines() if b.strip()]
        fora = []
        for b in todos_r:
            if b == t: continue
            m = subprocess.run(["git", "-C", raiz, "merge-base", "--is-ancestor", b, t],
                               capture_output=True, timeout=20)
            if m.returncode != 0: fora.append(b)
        return fora
    except Exception: return []

def data(s):
    try: return datetime.date.fromisoformat(s)
    except ValueError: return None

def adicionado_em(f):
    """o compromisso que ADICIONOU este objeto no repositorio"""
    if not f: return None
    try:
        r = subprocess.run(["git", "-C", raiz, "log", "--all", "--format=%H",
                            "--diff-filter=A", "--", os.path.relpath(f, raiz)],
                           capture_output=True, text=True, timeout=30)
        linhas = [x.strip() for x in r.stdout.splitlines() if x.strip()]
        return linhas[-1] if linhas else None
    except Exception:
        return None

def fundido(f):
    """True quando o ramo que criou a declaracao ja' esta' na linha principal"""
    t = tronco()
    c = adicionado_em(f)
    if not t or not c: return False
    try:
        return subprocess.run(["git", "-C", raiz, "merge-base", "--is-ancestor", c, t],
                              capture_output=True, timeout=30).returncode == 0
    except Exception:
        return False

def encerradas(objs, idx):
    """As A5 com VEREDITO escrito — linha `encerramento: <endereco>` no texto da anotacao.
    O git diz se o ramo foi fundido; so' o veredito diz se a PERGUNTA foi respondida."""
    s = set()
    for h, c in idx.items():
        t = c.get("conteudo", "")
        if len(t) != 64: continue
        for hh, f, _ in objs:
            if hh != t: continue
            try: b = open(f, "rb").read()
            except Exception: break
            for m in re.finditer(rb"(?m)^encerramento:[ ]([0-9a-f]{64})[ ]*$", b):
                s.add(m.group(1).decode())
            break
    return s

def main():
    objs = list(todos())
    idx = {h: campos(f) for h, f, _ in objs}
    prov_de = {h: p for h, _, p in objs}
    caminho_de = {h: f for h, f, _ in objs}
    ENCERRADAS = encerradas(objs, idx)
    # quem e' alcancado, por qualquer campo de 64 hex
    apontados = set()
    for h, c in idx.items():
        for v in c.values():
            if len(v) == 64: apontados.add(v)

    alertas = []   # (nivel, rotulo, endereco, motivo)

    # ---- 3. CONFORMIDADE COM O ITINERARIO ----
    declarados, fundidas = {}, []
    for h, c in idx.items():
        if c.get("tipo") == "declaracao" and c.get("ramo"):
            b = c["ramo"]
            try:
                vivo = subprocess.run(["git", "-C", raiz, "rev-parse", "--verify", b],
                                      capture_output=True, timeout=20).returncode == 0
            except Exception:
                vivo = False
            if not vivo and fundido(caminho_de.get(h)):
                fundidas.append((h, b)); continue
            declarados.setdefault(b, []).append((h, c.get("prazo", "")))
    for b in ramos():
        if b not in declarados:
            alertas.append((3, "RAMO SEM DECLARACAO", b,
                            "trabalho nao fundido e o itinerario nao o registra"))
        else:
            for h, p in declarados[b]:
                d = data(p)
                if d is None:
                    alertas.append((3, "PRAZO MALFORMADO", h, "%s — ramo %s" % (p, b)))
                elif (d - HOJE).days < 0:
                    alertas.append((3, "PRAZO VENCIDO", h, "ha' %d dia(s) — ramo %s" % (-(d - HOJE).days, b)))
    for b, lst in declarados.items():
        try:
            ex = subprocess.run(["git", "-C", raiz, "rev-parse", "--verify", b],
                                capture_output=True, text=True, timeout=20)
            if ex.returncode != 0:
                for h, _ in lst: alertas.append((2, "DECLARACAO DE RAMO INEXISTENTE", h, b))
        except Exception: pass

    FUNDIDAS = set(h for h, _ in fundidas)
    for h, b in fundidas:
        alertas.append((1, "RAMO FUNDIDO", h, b + (" — encerrada: ha' veredito no deposito"
                       if h in ENCERRADAS else " — fundida, e sem veredito escrito")))

    # ---- 1 e 2. A BOLHA E OS METADADOS ----
    for h, c in idx.items():
        if not c: continue
        esp = c.get("tipo")
        if esp is None:
            if h not in apontados:
                alertas.append((3, "SEM TIPO E SEM ALCANCE", h, "artefato ate' prova em contrario"))
            continue
        p = c.get("prazo")
        if p and h not in FUNDIDAS:
            d = data(p)
            if d is None:      alertas.append((3, "PRAZO MALFORMADO", h, p))
            elif (d - HOJE).days < 0: alertas.append((3, "PRAZO VENCIDO", h, "ha' %d dia(s)" % -(d - HOJE).days))
            elif (d - HOJE).days <= 7: alertas.append((3, "PRAZO CURTO", h, "vence em %d dia(s)" % (d - HOJE).days))
            elif (d - HOJE).days <= 30: alertas.append((2, "PRAZO PROXIMO", h, "vence em %d dias" % (d - HOJE).days))
        if prov_de[h] == "quebrado" and c.get("tipo") not in ("declaracao",):
            alertas.append((2, "CASO NEGATIVO", h, "e' insumo de teste, nao conteudo"))
        if "nome" not in c and c.get("conteudo", "") == "":
            alertas.append((2, "SEM NOME PROPRIO", h, "so' alcancavel pelo endereco"))

    alertas.sort(key=lambda x: (-x[0], x[1], x[2]))
    marca = {3: "[!!!]", 2: "[ ! ]", 1: "[   ]"}
    print("ALERTAS — nivel por FATOS, nao por opiniao")
    print("  entram na conta: a bolha · os metadados · a conformidade com o itinerario")
    print("  linha principal: %s (medida no git, nao suposta)" % (tronco() or "?"))
    print()
    for n, rot, alvo, motivo in alertas:
        print("  %s %-28s %-14s %s" % (marca[n], rot, alvo[:14], motivo))
    a = sum(1 for x in alertas if x[0] == 3)
    print()
    print("  %d alerta(s) · %d em ALTO · %d em MEDIO · %d em memoria · %d objeto(s) varrido(s) e %d ramo(s) fora da pindorama"
          % (len(alertas), a, sum(1 for x in alertas if x[0] == 2),
             sum(1 for x in alertas if x[0] == 1), len(objs), len(ramos())))
    return 1 if a else 0

sys.exit(main())
