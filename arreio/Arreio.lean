/-- Classe de combinação canônica de um ponto de código (0 = não é marca). -/
def classeCombinacao (cp : Nat) : Nat :=
  ((tabelaClasse.find? (fun p => p.1 == cp)).map Prod.snd).getD 0

def decompor (s : String) : String :=
  String.join <| s.toList.map fun c =>
    ((tabelaDec.find? (fun p => p.1 == c.toNat)).map Prod.snd).getD c.toString

/-- Insere `c` numa lista já ordenada por classe, ESTÁVEL (empate fica à
    esquerda: `≤`). -/
def insClasse (c : Char) : List Char → List Char
  | [] => [c]
  | d :: ds =>
      if classeCombinacao c.toNat ≤ classeCombinacao d.toNat
      then c :: d :: ds
      else d :: insClasse c ds

/-- A ORDEM CANÔNICA: cada corrida de marcas é ordenada por classe de
    combinação, estável. Um iniciador (classe 0) nunca se move — é por isso
    que a corrida é acumulada e só despejada quando o iniciador aparece.

    O defeito anterior: a recursão inseria no FIM da cauda, o que invertia a
    lista inteira. O `papelDe` devolvia `oarfer` em vez de `refrao`. -/
def reordenar (l : List Char) : List Char :=
  let r := l.foldr (fun c (acc : List Char × List Char) =>
      if classeCombinacao c.toNat == 0
      then (c :: (acc.2 ++ acc.1), [])
      else (acc.1, insClasse c acc.2)) ([], [])
  r.2 ++ r.1

def compor : List Char → String
  | [] => ""
  | c :: rest =>
      match rest with
      | [] => c.toString
      | d :: ds =>
          match tabelaComp.find? (fun p => p.1.1 == c.toNat && p.1.2 == d.toNat) with
          | some p => p.2 ++ compor ds
          | none => c.toString ++ compor (d :: ds)

/-- A forma NORMAL (NFC): decompõe, reordena por classe, recompõe.
    Acentuação composta e decomposta são a MESMA palavra em duas grafias —
    e grafias diferentes dão ENDEREÇOS diferentes. A mão normaliza quando o
    texto entra; o juiz nem fica sabendo que isso existiu. -/
def nfc (s : String) : String := compor (reordenar (decompor s).toList)

/-- O texto sem acentos. -/
def semAcento (s : String) : String :=
  String.join <| s.toList.map fun c =>
    match tabelaSemAcento.find? (fun p => p.1 == c.toNat) with
    | some p => p.2
    | none => if decide (0x0300 ≤ c.toNat ∧ c.toNat ≤ 0x036f) then "" else c.toString

/-- O rótulo legível de uma janela. -/
def slug (texto : String) : String :=
  let t := (semAcento texto).toLower
  let s := String.ofList (t.toList.map fun c => if c.isAlphanum then c else ' ')
  "-".intercalate ((s.splitOn " ").filter (fun p => !p.isEmpty))

/-- O slug da MÚSICA: substitui corridas de não-[a-z0-9] por um `-` e apara.
    Diferente do `slug` acima — é o `re.sub` do arreio.py. -/
def slugMusica (titulo : String) : String :=
  let t := (semAcento titulo).toLower
  let cs := t.toList.map (fun c => if c.isAlphanum then c else '-')
  let rec colapsa (cs : List Char) (acc : List Char) (anterior : Bool) : List Char :=
    match cs with
    | [] => acc.reverse
    | c :: rest =>
        if c == '-' then
          (if anterior then colapsa rest acc true else colapsa rest ('-' :: acc) true)
        else colapsa rest (c :: acc) false
  let l := colapsa cs [] false
  let l := l.dropWhile (fun c => c == '-')
  let l := (l.reverse.dropWhile (fun c => c == '-')).reverse
  if l.isEmpty then "musica" else String.ofList l

/-- O marcador de uma parte: `[Refrão]` → `Refrão`. O `^\\s*\\[(.+?)\\]\\s*$`
    do Python, escrito à mão. `\\s*` das pontas é o `trim`. Rejeita `[]`. -/
def marcadorDe (linha : String) : Option String :=
  match linha.trim.toList with
  | '[' :: resto =>
      match resto.reverse with
      | ']' :: meioRev =>
          let meio := meioRev.reverse
          if meio.isEmpty then none else some (String.ofList meio)
      | _ => none
  | _ => none

def papeis : List (String × String) :=
  [("intro","intro"), ("introducao","intro"), ("verso","verso"), ("refrao","refrao"),
   ("pre-refrao","pre-refrao"), ("ponte","ponte"), ("outro","outro"),
   ("coro","refrao"), ("corpo","corpo")]

/-- O papel de uma parte, a partir do marcador: `[Refrão]` → `refrao`. -/
def papelDe (marcador : String) : String :=
  let chave := (semAcento (nfc marcador)).trim.toLower
  let semDig := chave.toList.filter (fun c => !c.isDigit)
  let ponta := fun c => c == ' ' || c == '-' || c == '_'
  let l := (String.ofList semDig).trim.toList.dropWhile ponta
  let l := (l.reverse.dropWhile ponta).reverse
  let hyp := String.ofList (l.map (fun c => if c == ' ' then '-' else c))
  match papeis.find? (fun p => p.1 == hyp) with
  | some p => p.2
  | none => if hyp.isEmpty then "corpo" else hyp

/-- Insere `x` numa lista já ordenada. -/
def inserir (x : String) : List String → List String
  | [] => [x]
  | y :: ys => if compare x y != .gt then x :: y :: ys else y :: inserir x ys

def ordenar : List String → List String
  | [] => []
  | x :: xs => inserir x (ordenar xs)

/-- Lê o arquivo da letra: [(papel, texto)], cada texto com um `\n` final. -/
def lerPartes (caminho : String) : IO (List (String × String)) := do
  let bruto ← IO.FS.readFile caminho
  let linhas := (nfc bruto).splitOn "\n"
  let mut partes : List (String × String) := []
  let mut papel : Option String := none
  let mut corpo : List String := []
  for linha in linhas do
    match marcadorDe linha with
    | some m =>
        match papel with
        | some p => partes := partes ++ [(p, String.intercalate "\n" corpo.reverse)]
        | none => pure ()
        papel := some (papelDe m)
        corpo := []
    | none =>
        match papel with
        | some _ => corpo := linha :: corpo
        | none => pure ()
  match papel with
  | some p => partes := partes ++ [(p, String.intercalate "\n" corpo.reverse)]
  | none => pure ()
  pure <| partes.map fun (p, texto) =>
    let ls := texto.splitOn "\n"
    let ls := ls.dropWhile (fun l => l.trim.isEmpty)
    let ls := (ls.reverse.dropWhile (fun l => l.trim.isEmpty)).reverse
    (p, nfc (String.intercalate "\n" ls) ++ "\n")

/-- Onde gravar, resolvido EM TEMPO DE EXECUÇÃO. As variáveis de ambiente
    `ARREIO_DEPOSITO` e `ARREIO_BOLHAS` apontam a mão para um acervo TEMPORÁRIO.
    É assim que o Python e o Lean podem ser comparados sem escrever no acervo
    real: cada um escreve no seu, e os dois têm de produzir os MESMOS nomes. -/
def lerDirs : IO (String × String) := do
  let dep := (← IO.getEnv "ARREIO_DEPOSITO").getD dirDeposito
  let vis := (← IO.getEnv "ARREIO_BOLHAS").getD dirBolhas
  pure (dep, vis)

def gravarObjeto (dep : String) (dados : ByteArray) : IO String := do
  let h := Sha256.enderecoBytes dados
  let p : System.FilePath := dep ++ "/" ++ h
  if ← System.FilePath.pathExists p then pure h
  else
    IO.FS.createDirAll dep
    IO.FS.writeBinFile p dados
    pure h

/-- O manifesto vai para os DOIS lugares: a janela legível e o depósito. -/
def gravarManifesto (dep vis nome texto : String) : IO String := do
  IO.FS.createDirAll vis
  IO.FS.writeFile (vis ++ "/" ++ nome ++ ".bolha") texto
  gravarObjeto dep texto.toUTF8

def criarBolhaLicenca (dep vis catalogo nome sigilo : String) : IO (Option String) := do
  let cs := [("tipo","licenca"), ("catalogo",catalogo), ("nome",nome), ("sigilo",sigilo)]
  match serializarCampos cs with
  | none => pure none
  | some m => some <$> gravarManifesto dep vis ("licenca-" ++ catalogo ++ "-" ++ nome) m

/-- O FLUXO DA MÚSICA: letra → partes numeradas → bolha da música. -/
def importarMusica (dep vis caminho titulo interprete licenca : String)
    : IO (String × String × List (Nat × String × String × String) × String) := do
  let partes ← lerPartes caminho
  if partes.isEmpty then throw (IO.userError s!"nenhuma parte em {caminho}: marque cada parte com [Nome]")
  let titulo := nfc titulo
  let interprete := nfc interprete
  let mut enderecos : List String := []
  let mut mapa : List (Nat × String × String × String) := []
  let mut letraInteira := ""
  let mut numero := 0
  for (papel, texto) in partes do
    numero := numero + 1
    letraInteira := letraInteira ++ texto
    let hTexto ← gravarObjeto dep texto.toUTF8
    let dois := if numero < 10 then "0" else ""
    let nomeJanela := "parte-" ++ dois ++ toString numero ++ "-" ++ (hTexto.take 12).toString
    let cs := [("tipo","parte"), ("numero", toString numero), ("papel", papel),
               ("letra", hTexto), ("licenca", licenca)]
    match serializarCampos cs with
    | none => throw (IO.userError "especie parte invalida")
    | some m =>
        let hParte ← gravarManifesto dep vis nomeJanela m
        enderecos := enderecos ++ [hParte]
        mapa := mapa ++ [(numero, papel, hTexto, hParte)]
  let hLetra ← gravarObjeto dep letraInteira.toUTF8
  let cs := [("tipo","musica"), ("titulo",titulo), ("interprete",interprete),
             ("letra",hLetra), ("partes", ",".intercalate enderecos), ("licenca",licenca)]
  match serializarCampos cs with
  | none => throw (IO.userError "especie musica invalida")
  | some m =>
      let hMusica ← gravarManifesto dep vis ("musica-" ++ slugMusica titulo) m
      pure (hMusica, m, mapa, hLetra)

/-- Verificação independente: cada arquivo se chama pelo sha256 dos bytes? -/
def conferirDeposito : IO (Nat × Nat) := do
  let entradas ← System.FilePath.readDir dirDeposito
  let mut conferem := 0
  let mut divergem := 0
  for e in entradas do
    if ← System.FilePath.isDir e.path then continue
    let dados ← IO.FS.readBinFile e.path
    if Sha256.enderecoBytes dados == e.fileName then conferem := conferem + 1
    else
      divergem := divergem + 1
      IO.println s!"  DIVERGE: {e.fileName}"
  pure (conferem, divergem)

/-- Lê os campos de um objeto. NÃO valida: quem valida é o juiz. -/
def camposDoTexto (texto : String) : List (String × String) :=
  (texto.splitOn "\n").filterMap fun linha =>
    if linha.trim.isEmpty || !(linha.contains ':') then none
    else
      match linha.splitOn ":" with
      | [] => none
      | k :: vs => some (k.trim, (":".intercalate vs).trim)

def nomeDaJanela (texto : String) : Option String :=
  let c := camposDoTexto texto
  let g (k : String) : Option String := (c.find? (fun p => p.1 == k)).map Prod.snd
  match g "tipo" with
  | some "parte" =>
      match g "numero", g "letra" with
      | some n, some l =>
          let num := n.toNat?.getD 0
          let dois := if num < 10 then "0" else ""
          some ("parte-" ++ dois ++ toString num ++ "-" ++ (l.take 12).toString)
      | _, _ => none
  | some "anotacao" => (g "conteudo").map (fun x => "anotacao-" ++ (x.take 12).toString)
  | some "musica"   => (g "titulo").map (fun t => "musica-" ++ slug t)
  | some "licenca"  =>
      match g "catalogo", g "nome" with
      | some a, some b => some s!"licenca-{a}-{b}"
      | _, _ => none
  | _ => none

/-- Lista o mapeamento objeto -> janela, para conferir contra o Python. -/
def listarJanelas : IO Unit := do
  let entradas ← System.FilePath.readDir dirDeposito
  for n in ordenar (entradas.map (·.fileName)).toList do
    let p : System.FilePath := dirDeposito ++ "/" ++ n
    if ← System.FilePath.isDir p then continue
    let dados ← IO.FS.readBinFile p
    let nome := match String.fromUTF8? dados with
      | none => "SEM-JANELA"
      | some texto => (nomeDaJanela texto).getD "SEM-JANELA"
    let curto := (n.take 12).toString
    IO.println s!"{curto} -> {nome}"

def regenerarJanelas (dir : String) : IO Unit := do
  if !(← System.FilePath.isDir dir) then
    IO.println s!"nao ha deposito em {dir}"; return
  IO.FS.createDirAll dirBolhas
  let entradas ← System.FilePath.readDir dir
  let mut escritas := 0; let mut iguais := 0; let mut semNome := 0
  for n in ordenar (entradas.map (·.fileName)).toList do
    let p : System.FilePath := dir ++ "/" ++ n
    if ← System.FilePath.isDir p then continue
    let dados ← IO.FS.readBinFile p
    let nome := match String.fromUTF8? dados with
      | none => none
      | some texto => nomeDaJanela texto
    match nome with
    | none => semNome := semNome + 1
    | some janela =>
        let destino : System.FilePath := dirBolhas ++ "/" ++ janela ++ ".bolha"
        let existe ← System.FilePath.pathExists destino
        let mut igual := false
        if existe then igual := (← IO.FS.readBinFile destino) == dados
        if igual then iguais := iguais + 1
        else
          IO.FS.writeBinFile destino dados
          escritas := escritas + 1
          let curto := (n.take 12).toString
          IO.println s!"  {janela}.bolha  <-  {curto}..."
  IO.println s!"\njanelas: {escritas} escritas · {iguais} ja identicas · {semNome} sem janela"
  IO.println "a vista e projecao do deposito — nunca fonte."

def main : IO Unit := do
  IO.println "=== ARREIO em Lean — a MÃO ==="
  IO.println ""
  IO.println "1. a bolha-licenca CC0-1.0, pelo spec vivo:"
  let esp := "649e94ec807f83748732f58e401278d1546106739e11b9a55b4fcab9f7f3b015"
  let (dep0, vis0) ← lerDirs
  match ← criarBolhaLicenca dep0 vis0 "CC" "CC0-1.0" "publico" with
  | none => IO.println "   FALHOU: serializarCampos devolveu none"
  | some h =>
      IO.println s!"   {h}"
      IO.println (if h == esp then "   IGUAIS — confere com o deposito" else "   DIFEREM")
  IO.println ""
  IO.println "2. lerPartes de /tmp/letra.txt:"
  let partes ← lerPartes "/tmp/letra.txt"
  for (papel, texto) in partes do
    IO.println s!"{papel}|{" / ".intercalate (texto.splitOn "\n")}"
  IO.println ""
  IO.println "3. o papel de cada marcador:"
  for m in ["Refrão", "VERSO 2", "Intro", "[Ponte]", "Pré-refrão", "Coro"] do
    IO.println s!"   [{m}]  ->  {papelDe m}"
  IO.println ""
  IO.println "4. verificacao independente do deposito:"
  let (ok, ruim) ← conferirDeposito
  IO.println s!"   {ok} conferem (nome == sha256 dos bytes), {ruim} divergem"
  IO.println ""
  IO.println "5. a VISTA reconstruida:"
  regenerarJanelas dirDeposito

/-- `s` começa com `pre`? (sem depender de API que muda) -/
def comecaCom (pre s : String) : Bool :=
  s.toList.take pre.length == pre.toList

def padEsq (n : Nat) (s : String) : String :=
  if s.length ≥ n then s else String.ofList (List.replicate (n - s.length) ' ' ++ s.toList)

def padDir (n : Nat) (s : String) : String :=
  if s.length ≥ n then s else String.ofList (s.toList ++ List.replicate (n - s.length) ' ')

/-- Lê pares `--chave valor` de uma lista de argumentos. -/
def lerOpcoes : List String → List (String × String)
  | a :: b :: resto =>
      if comecaCom "--" a then ((a.drop 2).toString, b) :: lerOpcoes resto
      else lerOpcoes (b :: resto)
  | _ => []

def opcao (ops : List (String × String)) (k : String) : Option String :=
  (ops.find? (fun p => p.1 == k)).map Prod.snd

/-- O MAPA: a letra inteira organizada, com o endereço de cada parte.
    Formato idêntico ao `imprimir_mapa` do arreio.py. -/
def imprimirMapa (titulo interprete licenca hMusica hLetra : String)
    (mapa : List (Nat × String × String × String)) : IO Unit := do
  IO.println s!"\n=== MAPA DA MÚSICA — {titulo} ({interprete}) ==="
  IO.println s!"  bolha da música   endereço: {hMusica}"
  IO.println s!"  letra inteira     endereço: {hLetra}   (a reunião das partes, na ordem)"
  IO.println s!"  licença: {licenca}"
  IO.println ""
  IO.println "  nº | papel        | texto da parte          | bolha da parte (endereço)"
  IO.println "  ---+--------------+-------------------------+------------------------------------------"
  for (numero, papel, hTexto, hParte) in mapa do
    IO.println s!"  {padEsq 2 (toString numero)} | {padDir 12 papel} | {hTexto} | {hParte}"

/-- O FLUXO DA MÚSICA pela linha de comando:
      arreio musica <letra.txt> --titulo T --interprete I [--licenca L] [--mapa A] -/
def fluxoMusica (args : List String) : IO UInt32 := do
  match args with
  | [] =>
      IO.println "uso: arreio musica <letra.txt> --titulo T --interprete I [--licenca L] [--mapa A]"
      pure 1
  | caminho :: resto =>
    let ops := lerOpcoes resto
    match opcao ops "titulo", opcao ops "interprete" with
    | none, _ | _, none =>
        IO.println "faltou --titulo e/ou --interprete: a bolha da canção carrega os dois."
        pure 1
    | some titulo, some interprete =>
        let licenca := (opcao ops "licenca").getD "reservado"
        if licenca != "reservado" && licenca.length != 64 then
          IO.println s!"licença {licenca}: ou `reservado`, ou o hash (64) de uma bolha-licença."
          pure 1
        else
          let (dep, vis) ← lerDirs
          let (hMusica, manifesto, mapa, hLetra) ← importarMusica dep vis caminho titulo interprete licenca
          imprimirMapa titulo interprete licenca hMusica hLetra mapa
          IO.println "\n  bolha da música:"
          for linha in manifesto.trimRight.splitOn "\n" do
            IO.println s!"    {linha}"
          match opcao ops "mapa" with
          | some destino =>
              let cab := s!"# MAPA DA MÚSICA — {titulo} ({interprete}) — GERADO, nunca escrito à mão\n\n"
              let tab := "| nº | papel | texto da parte | bolha da parte |\n|---|---|---|---|\n"
              let linhas := mapa.map (fun (n, p, ht, hp) =>
                s!"| {n} | {p} | `{ht}` | `{hp}` |\n")
              let rodape := s!"\nbolha da música: `{hMusica}`\nletra inteira: `{hLetra}`\nlicença: {licenca}\n"
              IO.FS.writeFile destino (cab ++ tab ++ "\n".intercalate linhas ++ rodape)
              IO.println s!"  mapa escrito em {destino} (GERADO)"
              pure 0
          | none => pure 0

/-- A linha de comando inteira. -/
def cli (args : List String) : IO UInt32 := do
  let (dep, vis) ← lerDirs
  IO.FS.createDirAll dep
  IO.FS.createDirAll vis
  match args with
  | "musica" :: resto => fluxoMusica resto
  | "janelas" :: resto =>
      let dep := match resto with
        | "--de" :: d :: _ => d
        | _ => dirDeposito
      regenerarJanelas dep
      pure 0
  | _ => Arreio.main; pure 0

end Arreio

/-- Entrada: `lean --run arreio/Arreio.lean -- musica <letra.txt> --titulo T ...` -/
def main (args : List String) : IO Unit := discard <| Arreio.cli args
