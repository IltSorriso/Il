#!/bin/sh
# O PORTÃO — local, sem Actions.
#
# O projeto NÃO usa GitHub Actions. A prova mora aqui, e o momento de cobrá-la
# é este: o empurrão. A cadeia é a MESMA que roda em qualquer máquina — o CI
# nunca foi a fonte, era só um atalho de velocidade.
#
# Para pular (você sabe o que está fazendo):  git push --no-verify

# ── E HÁ UM PORTÃO ANTES DESTE, E ELE NÃO TEM ESCAPE ──────────────────────────
# O ateliê PUXA do Il e NUNCA empurra para lá. Se um push saísse para o Il, ele
# levaria o acervo PRIVADO para o repositório PÚBLICO — e isso não se desfaz:
# endereço publicado é endereço na mão de outra pessoa.
#
# A condição é "o alvo é o Il E este repositório não é o Il". No próprio Il nada
# dispara (lá o `origin` É o Il, e empurrar para si mesmo é o normal).
# NOMES EXATOS, NÃO SUBSTRING. A primeira versão procurava "IltSorriso/Il" e
# ACEITAVA "IltSorriso/IltS.git" — porque `Il` é PREFIXO de `IltS`, e um `grep`
# de substring não distingue os dois. O guarda que existe para separar os dois
# repositorios não os separava. Aqui se compara o NOME, que é igual a si mesmo.
alvo=$(printf '%s' "$2" | awk -F/ '{print $NF}' | sed 's/[.]git$//')
origem=$(git config --get remote.origin.url 2>/dev/null | awk -F/ '{print $NF}' | sed 's/[.]git$//')
if [ "$1" = "il" ] || { [ "$alvo" = "Il" ] && [ "$origem" != "Il" ]; }; then
  echo "  PORTÃO FECHADO — este push iria para o Il (público)."
  echo "  O ateliê puxa do Il e NUNCA empurra para lá."
  echo "  Para empurrar o ateliê:  git push origin atelie"
  exit 1
fi
echo "portão: rodando a cadeia antes de empurrar (2 a 3 min)..."
if ! lean --run cadeia/Cadeia.lean --etapa tudo; then
  echo
  echo "  PORTÃO FECHADO — a cadeia falhou. Nada foi empurrado."
  echo "  O recibo diz qual passo quebrou: recibo-tudo.txt"
  echo "  Para pular conscientemente: git push --no-verify"
  exit 1
fi
echo "  PORTÃO ABERTO — pode empurrar."
